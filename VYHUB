        state.status = string.format("visiting merchant at camp %d", ph.Camp)
        teleportTo(standPos, stop.Position)
        task.wait(0.8)
        local data = merchantOffers()
        local tw = os.clock()
        while state.alive and not data and os.clock() - tw < 3 do
            task.wait(0.5)
            data = merchantOffers()
        end
        local offers = data and type(data.Offers) == "table" and data.Offers or nil
        local lvl = respectLevel()
        local n = 6
        if offers then
            local c = 0
            for _ in pairs(offers) do c += 1 end
            if c > 0 then n = c end
        end
        local bought, skipped, notHere = 0, 0, false
        for i = 1, n do
            local o = offers and (offers[tostring(i)] or offers[i]) or nil
            local already = ledger ~= nil and data ~= nil and ledger.seed == data.Seed and (tonumber(ledger.purchases[tostring(i)] or ledger.purchases[i]) or 0) >= 1
            local skip = already or (o ~= nil and (o.Respect or 0) > lvl) or (o ~= nil and F.merchantOnlyBoosts and not offerIsBoost(o))
            if skip then
                skipped += 1
            else
                local ok, res, msg = netInvoke("Merchant_RequestPurchase", K.MERCHANT, i)
                local text = tostring(msg or res or "")
                if ok and res == true then
                    bought += 1
                    state.merchantBought += 1
                    log("merchant: bought %s", o and offerName(o) or ("offer " .. i))
                else
                    skipped += 1
                    log("merchant: offer %d not bought (%s)", i, text)
                    if text:lower():find("not here", 1, true) then notHere = true break end
                end
                task.wait(0.5)
            end
        end
        if notHere then
            V.merchantRetryAt = os.clock() + 30
            state.status = "merchant not reachable here, retrying in 30s"
            return
        end
        V.merchantDoneWindow = lastB
        V.merchantPartialAt = os.clock()
        if bought > 0 then notify("Traveling Merchant", string.format("bought %d offer(s) at camp %d", bought, ph.Camp), 5) end
        local after = merchantLedger()
        state.merchantNote = string.format("%d/6 bought, restock in %dm", after and after.bought or bought, math.max(0, math.floor((nextB - workspace:GetServerTimeNow()) / 60)))
        state.status = string.format("merchant visit done (%d bought, %d skipped)", bought, skipped)
    end)
    if before and state.alive then teleportTo(before) end
    releaseExcursion("merchant")
end

