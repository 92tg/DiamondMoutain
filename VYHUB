task.spawn(function()
    local resume = loadResume()
    if resume then
        task.wait(2)
        V.resumePrivate = resume.private == true
        local flags = type(resume.flags) == "table" and resume.flags or {}
        local late = { dm_autoTrail = true, dm_autoYeti = true, dm_bestEgg = true, dm_nearestEgg = true, dm_autoMerchant = true, dm_autoArtifacts = true, dm_autoUpgrades = true, dm_autoBoosts = true }
        local function apply(name, value)
            local setter = Library.SetFlags and Library.SetFlags[name]
            if type(setter) == "function" then pcall(setter, value) end
        end
        for name, value in pairs(flags) do
            if not late[name] then apply(name, value) end
        end
        for name in pairs(late) do
            if flags[name] ~= nil then apply(name, flags[name]) end
        end
        tlog("landed: place %s job %s private %s, resumed settings (%s)", tostring(game.PlaceId), tostring(game.JobId):sub(1, 8), tostring(inPrivateServer()), tostring(resume.mode or "?"))
        local hereWorld = K.WORLD_PLACES[game.PlaceId]
        V.resumeMode = nil
        V.resumeHops = 0
    end
    local ok, err = enterInstance()
    if ok then
        state.status = "inside Diamond Mountain"
        notify("VY HUB", "Diamond Mountain loaded - RightShift opens the menu", 6)
    else
        state.status = "not inside Diamond Mountain (" .. tostring(err) .. ")"
        notify("VY HUB", "Could not enter Diamond Mountain: " .. tostring(err), 8)
        local hereWorld = K.WORLD_PLACES[game.PlaceId]
        if resume and type(resume.world) == "number" and hereWorld ~= nil and hereWorld ~= resume.world and (tonumber(resume.hops) or 0) < 2 then
            tlog("mountain not enterable here, teleporting to World %d", resume.world)
            V.resumeMode = resume.mode
            V.resumeHops = (tonumber(resume.hops) or 0) + 1
            saveResume()
            queueReexec()
            local okW, res, msg = netInvoke("World" .. resume.world .. "Teleport")
            if not (okW and res == true) then tlog("world teleport failed: %s", tostring(msg or res)) end
        end
    end
end)

