local function expeditionPower(i)
    local D = isfn(G.DMCmds, "Feature") and gval(G.DMCmds.Feature, "Deposit") or nil
    if type(D) ~= "table" then return 0 end
    local ok, stacks = gcall(D.Stacks, "trip:" .. i)
    if ok and type(stacks) == "table" and stacks[1] then return tonumber(stacks[1].power) or 0, stacks[1].id end
    return 0, nil
end
local function expeditionRun()
    local pedestals, T = expeditionPedestals()
    if not pedestals then return end
    local plan = {}
    local candidates = dmPetStacks()
    local used = {}
    for i = 1, 4 do
        local ped = pedestals[i]
        if type(ped) == "table" and ped.unlocked == true then
            local hasPet = type(ped.trip) == "table" and type(ped.trip.pet) == "table"
            local curPower, curId = 0, nil
            if hasPet then curPower, curId = expeditionPower(i) end
            local best
            for _, c in ipairs(candidates) do
                local left = c.amount - (used[c.uid] or 0)
                if not c.equipped and left > 0 and c.power > curPower then best = c break end
            end
            if best then
                used[best.uid] = (used[best.uid] or 0) + 1
                plan[#plan + 1] = { i = i, uid = best.uid, id = best.id, power = best.power, replace = hasPet, curPower = curPower, curId = curId }
            end
        end
    end
    if #plan == 0 then
        state.expeditionNote = "all expeditions hold your best unequipped pets"
        return
    end
    local t0 = os.clock()
    while state.alive and state.excursion ~= nil and state.excursion ~= "expedition" do
        if os.clock() - t0 > 20 then return end
        task.wait(0.2)
    end
    if not state.alive then return end
    state.excursion = "expedition"
    local before = playerPos()
    pcall(function()
        for _, job in ipairs(plan) do
            if not state.alive then break end
            local pos = expeditionPedestalPos(job.i)
            if pos then
                teleportTo(pos + Vector3.new(0, 3, 4), pos)
                task.wait(0.6)
            end
            if job.replace then
                local okP, resP, msgP = gcall(T.Pull, job.i)
                if not (okP and resP == true) then
                    log("expedition %d: could not pick up %s (%s)", job.i, tostring(job.curId), tostring(msgP or resP))
                    continue
                end
                task.wait(0.8)
            end
            local okS, resS, msgS = gcall(T.Send, job.i, job.uid)
            if okS and resS == true then
                state.expeditionSends += 1
                log("expedition %d: sent %s (power %s%s)", job.i, tostring(job.id), tostring(job.power), job.replace and (", replaced " .. tostring(job.curId) .. " " .. tostring(job.curPower)) or "")
            else
                log("expedition %d: send failed (%s)", job.i, tostring(msgS or resS))
            end
            task.wait(0.8)
        end
    end)
    state.expeditionNote = string.format("%d change(s) applied", #plan)
    if before and state.alive then teleportTo(before) end
    releaseExcursion("expedition")
end

