loop("ui", 1, function()
    setText(UI.lblStatus, "Status: " .. tostring(state.status))
    setText(UI.lblAcorns, "Acorns: " .. shorten(acorns()) .. (inInstance() and "" or "  (not inside Diamond Mountain)"))
    local best = bestCampNumber()
    setText(UI.lblCamp, "Best camp: " .. (K.CAMPS[best] and K.CAMPS[best].Name or tostring(best)))
    setText(UI.lblCounters, string.format("Hatched: %d (requested %d) | Upgrades: %d | Boosts: %d | Merchant: %d", state.hatched, state.hatchRequests, state.upgradesBought, state.boostsUsed, state.merchantBought))
    setText(UI.lblFarm, string.format("Farm ticks: %d | Taps: %d | Orbs: %d", state.farmTicks, state.taps, state.orbs))
    setText(UI.lblUlt, ultimateStatus())
    local st = state.trail
    if F.autoTrail and st then
        local txt
        if st.eggLeft then
            txt = string.format("Trail %d: egg open %ds", st.number, math.floor(st.eggLeft))
        elseif st.closed then
            txt = string.format("Trail %d: closed%s", st.number, st.sleepLeft and string.format(" (%dm)", math.ceil(st.sleepLeft / 60)) or "")
        else
            txt = string.format("Trail %d: open, chest %d/3%s", st.number, st.chest or 1, st.rollIn > 0 and string.format(", roll in %ds", st.rollIn) or "")
        end
        setText(UI.lblTrail, txt .. string.format(" | trail eggs hatched: %d", state.trailHatched))
    else
        local parts = {}
        for i = 1, 6 do
            local s = trailState(i)
            parts[#parts + 1] = string.format("%d:%s", i, s.eggLeft and "EGG" or (s.closed and "closed" or "open"))
        end
        setText(UI.lblTrail, "Trails " .. table.concat(parts, "  "))
    end
    local yi = state.yeti or yetiInfo()
    if yi then
        local txt
        if yi.alive then
            txt = string.format("Yeti: alive %s%%%s", type(yi.health) == "number" and type(yi.maxHealth) == "number" and yi.maxHealth > 0 and tostring(math.floor(yi.health / yi.maxHealth * 100)) or "?", yi.cooldown > 0 and string.format(", your cooldown %ds", math.floor(yi.cooldown)) or "")
        elseif type(yi.backAt) == "number" then
            txt = string.format("Yeti: returns in %ds", math.max(0, math.floor(yi.backAt - serverNow())))
        else
            txt = "Yeti: not here"
        end
        setText(UI.lblYeti, txt)
    end
    setText(UI.lblYeti2, "Pets sent: " .. tostring(state.yetiPetsSent))
    do
        local f = dmAttrFolder()
        local meter = f and tonumber(f:GetAttribute("DM_HypeMeter")) or 0
        local need = f and tonumber(f:GetAttribute("DM_HypeNeed")) or 0
        local stage = f and tonumber(f:GetAttribute("DM_HypeStage")) or 1
        local names = { "Normal", "Golden", "Rainbow", "Shiny", "Rainbow Shiny" }
        setText(UI.lblFeed, string.format("Yeti: %s, charge %s / %s | fed %d pets%s", names[stage] or tostring(stage), shorten(meter), shorten(need), state.fedPets, state.feedNote and (" | " .. state.feedNote) or ""))
    end
    do
        local pedestals = expeditionPedestals()
        local parts = {}
        if pedestals then
            for i = 1, 4 do
                local ped = pedestals[i]
                if type(ped) == "table" then
                    if not ped.unlocked then parts[#parts + 1] = i .. ":locked"
                    elseif type(ped.trip) == "table" and type(ped.trip.pet) == "table" then parts[#parts + 1] = i .. ":" .. tostring(ped.trip.pet.id)
                    else parts[#parts + 1] = i .. ":empty" end
                end
            end
        end
        setText(UI.lblExpedition, "Expeditions " .. (#parts > 0 and table.concat(parts, "  ") or "-") .. string.format(" | sent %d%s", state.expeditionSends, state.expeditionNote and (" | " .. state.expeditionNote) or ""))
        local nextIn = math.max(0, math.floor(math.max(1, F.claimMinutes) * 60 - (os.clock() - V.claimLastAt)))
        setText(UI.lblClaim, string.format("Loot: claimed %d times%s%s", state.lootClaims, F.autoClaimLoot and string.format(", next in %dm %02ds", math.floor(nextIn / 60), nextIn % 60) or "", state.claimNote and (" | " .. state.claimNote) or ""))
    end
    local egg = state.hatchTarget
    if egg then
        local cost = eggCost(egg)
        setText(UI.lblEgg, string.format("Egg: %s (x%d, %s acorns each)", egg.id, maxHatch(egg), cost and shorten(cost) or "?"))
    else
        setText(UI.lblEgg, "Egg: -")
    end

    local coins = acorns()
    local allMax = true
    for _, u in ipairs(K.UPGRADES) do
        if not u.Retired and UI.lblUpgrades[u.Key] then
            local info = upgradeInfo(u)
            local txt
            if info.disabled then
                txt = string.format("%s  -  not available", u.Name)
            elseif info.tier >= info.max then
                txt = string.format("%s  -  MAX", u.Name)
            else
                allMax = false
                txt = string.format("%s  -  level %d of %d, next costs %s acorns%s", u.Name, info.tier, info.max, info.cost and shorten(info.cost) or "?", (info.cost and info.cost <= coins) and " (you can afford it)" or "")
            end
            setText(UI.lblUpgrades[u.Key], txt)
        end
    end
    local cand = pickUpgrade()
    if cand then
        setText(UI.lblRecommend, string.format("Next purchase: %s level %d for %s acorns", cand.u.Name, cand.info.tier + 1, shorten(cand.info.cost)))
    elseif allMax then
        setText(UI.lblRecommend, "Next purchase: everything is maxed")
    else
        setText(UI.lblRecommend, "Next purchase: nothing affordable right now")
    end

    for _, b in ipairs(K.BOOSTS) do
        local t1 = isfn(G.BoostCmds, "GetTimer") and (gval(G.BoostCmds.GetTimer, b.Ids[1]) or 0) or 0
        local t2 = isfn(G.BoostCmds, "GetTimer") and (gval(G.BoostCmds.GetTimer, b.Ids[2]) or 0) or 0
        local items = boostItems(b.Item)
        local n1, n2 = 0, 0
        for _, it in ipairs(items) do if it.tier == 2 then n2 += it.amount else n1 += it.amount end end
        local active
        if t2 > 0 then
            active = string.format("Tier II active, %dm left", math.floor(t2 / 60))
        elseif t1 > 0 then
            active = string.format("Tier I active, %dm left", math.floor(t1 / 60))
        else
            active = "not active"
        end
        setText(UI.lblBoosts[b.Key], string.format("%s  -  %s  |  you own %d (I) and %d (II)", b.Label, active, n1, n2))
    end

    local ph = merchantPhase()
    if ph then
        local now = workspace:GetServerTimeNow()
        if ph.Arrived then
            setText(UI.lblMerchant, string.format("Merchant: camp %d, leaves in %dm %02ds%s", ph.Camp, math.max(0, math.floor((ph.LeaveAt - now) / 60)), math.max(0, math.floor(ph.LeaveAt - now) % 60), state.merchantNote and (" | " .. state.merchantNote) or ""))
        else
            setText(UI.lblMerchant, string.format("Merchant: traveling to camp %d (%ds)", ph.Camp, math.max(0, math.floor(ph.ArriveAt - now))))
        end
    else
        setText(UI.lblMerchant, "Merchant: -")
    end

    local found = readArtifactState()
    local n = 0
    local list = {}
    for i = 1, 6 do if found[i] then n += 1 list[#list + 1] = tostring(i) end end
    state.artifactsFound = n
    setText(UI.lblArtifacts, string.format("Artifacts: %d/6 found %s", n, n > 0 and ("(" .. table.concat(list, ",") .. ")") or ""))
end)

