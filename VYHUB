                    set[it] = true
                else
                    local okU, uid = pcall(function() return it:GetUID() end)
                    if okU and uid then set[uid] = true end
                end
            end
        end
    end
    if isfn(G.PetCmds, "GetEquipped") then
        local ok, list = gcall(G.PetCmds.GetEquipped)
        if ok and type(list) == "table" then
            for k, v in pairs(list) do
                if type(v) == "string" then set[v] = true elseif type(k) == "string" then set[k] = true end
                if type(v) == "table" and type(v.uid) == "string" then set[v.uid] = true end
            end
        end
    end
    return set
