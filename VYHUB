local function tlog(fmt, ...)
    local ok, msg = pcall(string.format, fmt, ...)
    local line = ok and msg or tostring(fmt)
    log("%s", line)
    pcall(function()
        local entry = os.date("%H:%M:%S") .. " " .. line .. "\n"
        local exists = type(isfile) == "function" and isfile(K.TRACE_FILE)
        if exists and type(appendfile) == "function" then
            appendfile(K.TRACE_FILE, entry)
        elseif type(writefile) == "function" then
            local prev = (exists and type(readfile) == "function") and readfile(K.TRACE_FILE) or ""
            writefile(K.TRACE_FILE, prev .. entry)
        end
    end)
end

local function reservedChain()
    local ok, data = pcall(function() return game:GetService("TeleportService"):GetLocalPlayerTeleportData() end)
    return ok and type(data) == "table" and type(data.ReservedCode) == "string" and data.ReservedCode ~= ""
end

local function inPrivateServer()
    local ok, v = pcall(function() return tostring(game.PrivateServerId) ~= "" or (tonumber(game.PrivateServerOwnerId) or 0) ~= 0 end)
    if ok and v then return true end
    if V.resumePrivate then return true end
    return reservedChain()
end
local function saveResume()
    if type(writefile) ~= "function" then return end
    pcall(function()
        if type(makefolder) == "function" and type(isfolder) == "function" and not isfolder("VYHUB") then makefolder("VYHUB") end
        local flags = {}
        if type(Library) == "table" and type(Library.Flags) == "table" then
            for name, value in pairs(Library.Flags) do
                if type(name) == "string" and name:sub(1, 3) == "dm_" and (type(value) == "boolean" or type(value) == "number" or type(value) == "string") then
                    flags[name] = value
                end
            end
        end
        writefile(K.RESUME_FILE, game:GetService("HttpService"):JSONEncode({
            at = os.time(),
            originPlace = game.PlaceId,
            world = K.WORLD_PLACES and K.WORLD_PLACES[game.PlaceId] or nil,
            mode = V.resumeMode,
            hops = V.resumeHops or 0,
            private = inPrivateServer(),
            flags = flags,
        }))
    end)
end

local function queueReexec()
    if type(queue_on_teleport) ~= "function" then return end
    if V.reexecQueued then return end
    V.reexecQueued = true
    local src = table.concat({
        "repeat task.wait(1) until game:IsLoaded()",
        "local t0 = os.clock()",
        "local function ready()",
        "    local rs = game:GetService('ReplicatedStorage')",
        "    local lib = rs:FindFirstChild('Library')",
        "    local client = lib and lib:FindFirstChild('Client')",
        "    local util = lib and lib:FindFirstChild('Util')",
        "    local p = game:GetService('Players').LocalPlayer",
        "    return client ~= nil and client:FindFirstChild('Network') ~= nil and client:FindFirstChild('DiamondMountainCmds') ~= nil and util ~= nil and util:FindFirstChild('DiamondMountainMerchant') ~= nil and p ~= nil and p.Character ~= nil and p.Character:FindFirstChild('HumanoidRootPart') ~= nil",
        "end",
        "while not ready() and os.clock() - t0 < 120 do task.wait(1) end",
        "task.wait(3)",
        "local ok, err = pcall(function()",
        "    local s",
        "    if type(isfile) == 'function' and isfile('VY_DiamondMountain.luau') then s = readfile('VY_DiamondMountain.luau') end",
        "    if not s then s = game:HttpGet('" .. K.SCRIPT_URL .. "') end",
        "    loadstring(s, '=VY_DiamondMountain')()",
        "end)",
        "if not ok then warn('[VY DiamondMountain] re-exec failed: ' .. tostring(err)) end",
    }, "\n")
    pcall(queue_on_teleport, src)
end

local function pickOtherServer(placeId)
    placeId = placeId or game.PlaceId
    local body
    for _, order in ipairs({ "Desc", "Asc" }) do
        local ok, b = pcall(game.HttpGet, game, string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&excludeFullGames=true&limit=100", placeId, order))
        if ok and type(b) == "string" and #b > 10 then body = b break end
        task.wait(1)
    end
    if not body then return nil end
    local okJ, data = pcall(function() return game:GetService("HttpService"):JSONDecode(body) end)
    if not okJ or type(data) ~= "table" or type(data.data) ~= "table" then return nil end
    local choices = {}
    for _, s in ipairs(data.data) do
        if type(s) == "table" and s.id ~= game.JobId and type(s.playing) == "number" and type(s.maxPlayers) == "number" and s.playing < s.maxPlayers and s.playing >= 1 then
            choices[#choices + 1] = s.id
        end
    end
    if #choices == 0 then return nil end
    return choices[math.random(1, #choices)]
end

K.ROOT_PLACE = 8737899170
K.WORLD_PLACES = { [8737899170] = 1, [16498369169] = 2, [17503543197] = 3, [140403681187145] = 4 }

local function rootPlaceId()
    if K.WORLD_PLACES[game.PlaceId] then return K.ROOT_PLACE end
    local ok, body = pcall(game.HttpGet, game, "https://games.roblox.com/v1/games?universeIds=" .. tostring(game.GameId))
    if ok and type(body) == "string" then
        local id = tonumber(body:match('"rootPlaceId":(%d+)'))
        if id then return id end
    end
    return K.ROOT_PLACE
end


local function teleportAttempts()
    local root = rootPlaceId()
    local list = {}
    local target = pickOtherServer(root)
    if target then list[#list + 1] = { kind = "instance", place = root, job = target } end
    list[#list + 1] = { kind = "place", place = root }
    return list
end

local function leaveInstanceForTeleport()
    if not inInstance() then return true end
    if isfn(G.Instancing, "Leave") then gcall(G.Instancing.Leave, true, true) end
    local t0 = os.clock()
    while state.alive and os.clock() - t0 < 15 do
        local busy = isfn(G.Instancing, "IsBusy") and gval(G.Instancing.IsBusy) == true
        if not inInstance() and not busy then return true end
        task.wait(0.25)
    end
    return not inInstance()
end

local function doTeleport()
    if V.teleporting then return end
    V.teleporting = true
    local attempts = teleportAttempts()
    if #attempts == 0 then
        warnlog("rejoin: no usable teleport path from this place")
        notify("Rejoin", "No usable teleport path from here", 6)
        V.teleporting = false
        return
    end
    V.resumeMode = "hop"
    V.resumeHops = 0
    saveResume()
    queueReexec()
    local TS = game:GetService("TeleportService")
    local failed = false
    local conn = TS.TeleportInitFailed:Connect(function(player, result, msg)
        if player == LocalPlayer then
            failed = true
            tlog("teleport attempt rejected: %s %s", tostring(result), tostring(msg))
            if tostring(msg):lower():find("private instance", 1, true) then V.resumePrivate = true end
        end
    end)
    task.spawn(function()
        for i, a in ipairs(attempts) do
            if not state.alive then break end
            failed = false
            tlog("teleport attempt %d/%d: %s -> %s%s (place %s job %s private %s)", i, #attempts, a.kind, tostring(a.place or ("world " .. tostring(a.world))), a.job and (" @ " .. tostring(a.job):sub(1, 8)) or "", tostring(game.PlaceId), tostring(game.JobId):sub(1, 8), tostring(inPrivateServer()))
            local ok, err = pcall(function()
                if a.kind == "world" then
                    if not leaveInstanceForTeleport() then error("could not leave the instance") end
                    saveResume()
                    queueReexec()
                    local okW, res, msg = netInvoke("World" .. a.world .. "Teleport")
                    if not okW or res ~= true then error(tostring(msg or res or "world teleport refused")) end
                elseif a.kind == "instance" then
                    TS:TeleportToPlaceInstance(a.place, a.job, LocalPlayer)
                else
                    TS:Teleport(a.place, LocalPlayer)
                end
            end)
            if not ok then
                tlog("teleport call failed: %s", tostring(err))
                failed = true
            end
            local t0 = os.clock()
            while state.alive and not failed and os.clock() - t0 < (a.kind == "world" and 30 or 12) do task.wait(0.25) end
            if not failed then break end
            task.wait(1)
        end
        pcall(function() conn:Disconnect() end)
        V.teleporting = false
        if failed then
            V.resumeMode = nil
            V.trailClosedSince = os.clock() + 55
            tlog("all teleport attempts refused, next try in 60s")
            notify("Rejoin", "Teleport refused by the game, retrying in 60s", 6)
        end
    end)
end
local function trailClosedAction(st)
    if not F.trailHop then return end
    if not tonumber(tostring(F.trailChoice):match("%d+")) then return end
    if st.eggLeft then return end
    V.trailClosedSince = V.trailClosedSince or os.clock()
    if os.clock() - V.trailClosedSince < 5 then return end
    if V.teleporting then return end
    state.status = string.format("trail %d closed: hopping server", st.number)
    notify("Trail closed", "Hopping to another server", 5)
    doTeleport(false)
end

local function loadResume()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return nil end
    local ok, data = pcall(function()
        if not isfile(K.RESUME_FILE) then return nil end
        local raw = readfile(K.RESUME_FILE)
        delfile(K.RESUME_FILE)
        return game:GetService("HttpService"):JSONDecode(raw)
    end)
    if ok and type(data) == "table" and type(data.at) == "number" and os.time() - data.at < 600 then return data end
    return nil
end

local function trailTick()
    local st = pickTrail()
    if not st then
        V.trailFarmTargets = nil
        if state.excursion == "trail" then releaseExcursion("trail") end
        state.status = "no open trail"
        return
    end
    state.trail = st
    local pts = trailPoints(st.number)
    if not pts or not pts.center then
        V.trailFarmTargets = nil
        if state.excursion == "trail" then releaseExcursion("trail") end
        state.status = string.format("trail %d: model not found", st.number)
        return
    end
    if st.closed and not st.eggLeft then
        V.trailFarmTargets = nil
        if state.excursion == "trail" then releaseExcursion("trail") end
        state.status = string.format("trail %d closed%s", st.number, st.sleepLeft and string.format(" (%dm)", math.ceil(st.sleepLeft / 60)) or "")
        trailClosedAction(st)
        return
    end
    V.trailClosedSince = nil
    if state.excursion ~= nil and state.excursion ~= "trail" then return end
    state.excursion = "trail"
    local p = playerPos()
    local egg = st.eggLeft and trailEgg(st.number) or nil
    if egg and F.trailHatch then
        V.trailFarmTargets = nil
        if p and dist(p, egg.pos) > 18 and os.clock() - V.trailLastTeleport > 1.5 then
            V.trailLastTeleport = os.clock()
            teleportTo(egg.pos + Vector3.new(0, 3, 8), egg.pos)
            return
        end
        state.status = string.format("trail %d egg open (%ds): hatching %s", st.number, math.floor(st.eggLeft), egg.id)
        hatchOnce(egg)
        return
    end
    local targets = {}
    for _, m in ipairs(dmBreakableModels()) do
        if tostring(m:GetAttribute("AreaID")) == "Trail" .. st.number then targets[#targets + 1] = m:GetAttribute("BreakableUID") end
    end
    V.trailFarmTargets = #targets > 0 and targets or nil
    if #targets == 0 then
        state.status = string.format("trail %d: waiting for the boss chest", st.number)
        task.wait(1.5)
        return
    end
    local standAt = pts.center + Vector3.new(0, 3, 0)
    if #targets > 0 then
        local m = nil
        for _, mm in ipairs(dmBreakableModels()) do
            if mm:GetAttribute("BreakableUID") == targets[1] then m = mm break end
        end
        if m then
            local okP, pos = pcall(function() return m:GetPivot().Position end)
            if okP then standAt = pos + Vector3.new(0, 3, 0) end
        end
    end
    if p and dist(p, standAt) > 30 and os.clock() - V.trailLastTeleport > 1.5 then
        V.trailLastTeleport = os.clock()
        teleportTo(standAt)
    end
    state.status = string.format("farming trail %d (chest %d/3%s, %d targets)", st.number, st.chest or 1, st.rollIn > 0 and string.format(", roll in %ds", st.rollIn) or "", #targets)
end

local function loop(name, interval, fn)
    task.spawn(function()
        while state.alive do
            local ok, err = pcall(fn)
            if not ok then logOnce("loop-" .. name .. tostring(err):sub(1, 40), "%s loop error: %s", name, tostring(err)) end
            local dt = type(interval) == "function" and interval() or interval
            task.wait(dt)
        end
    end)
end

